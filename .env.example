# Gmail OAuth2
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_TOKEN_FILE=tokens/gmail_token.json

# Anthropic API
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Portal API (provided at session start)
PORTAL_BASE_URL=https://portal.example.com
PORTAL_API_KEY=your_portal_api_key_here

# Service Configuration
DATABASE_URL=sqlite:///./inbox_automation.db
WORKER_THREADS=4
POLL_INTERVAL_SECONDS=30
PENDING_QUOTE_TIMEOUT_HOURS=24

# Gmail Mailbox
GMAIL_MAILBOX_EMAIL=shared-inbox@freight-company.com
